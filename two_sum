nums = []
integer = 5
output = []
success = False

string_list = input("Please enter 5 numbers, separated by spaces.").split()

for item in string_list:
    nums.append(int(item))

for x in nums:
    value = integer - x
    for i in range(1, len(nums)):
        if nums[i] == value:
            output.extend([x, nums[i]])
            success = True
            break
    if success == True:
        break

print(f"Input: {nums}, integer = {integer}\nOutput: {output}")